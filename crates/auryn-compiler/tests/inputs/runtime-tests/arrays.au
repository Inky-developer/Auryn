// expect-output:
// 1
// 2
// 3
// Printing array...
// 1
// 42
// 3
// Done

fn main() {
    let a: []I32 = std.arrayOfZeros(3)
    a.set(0, 1)
    a.set(1, 2)
    a.set(2, 3)

    std.print(a.get(0))
    std.print(a.get(1))
    std.print(a.get(2))

    a.set(1, 42)

	std.print("Printing array...")
	print_array(a)
	std.print("Done")
}

fn print_array(array: []I32) {
	let length = array.len()
	let index: I32 = 0
	loop {
		if index >= length {
			break
		}

		std.print(array.get(index))
		index += 1
	}
}
