// expect-output:
// { y: 1, z: false }

fn main() {
	let a: []String = std.arrayOfZeros(3)
	a.set(0, "1")
	a.set(1, "2")
	a.set(2, "3")
	std.print(yz({x: 10, y: a}, {y: 11, z: false}))
}

fn yz[T, U](a: {x: I32, y: []T}, b: {y: I32, z: U}) -> {y: T, z: U} {
	let y = a.y.get(0)
	let z = b.z
	return {y: y, z: z}
}
