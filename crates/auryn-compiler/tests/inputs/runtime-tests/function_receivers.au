// expect-output:
// 2
// { data: [Hello, World] }
// 2
// Foo { data: [Hello, World] }
// 2

struct Foo {
	data: []String
}

fn (Foo) len(self) -> I32 {
	return self.data.len()
}

fn ({data: []String}) len(self) -> I32 {
	return self.data.len()
}

fn main() {
    let data: []String = std.arrayOfZeros(2)
    data.set(0, "Hello")
    data.set(1, "World")

	std.print(data.len())

	let structural = { data: data }
	std.print(structural)
	std.print(structural.len())

	let foo = Foo { data: data }
	std.print(foo)
	std.print(foo.len())
}
