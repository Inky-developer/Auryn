// expect-output:
// true
// false
// true
// false
// false
// true
// false
// true
// true

fn main() {
	let a = true
	std.print(a)
	let b = false
	std.print(b)
	std.print(a or b)
	std.print(a and b)
	std.print(not a)
	std.print(not b)
	std.print(not a and not b)
	std.print(not a or not b)
	std.print(not some_value())
}

fn some_value() -> Bool {
	return false
}
